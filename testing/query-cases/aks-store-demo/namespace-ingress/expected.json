{
  "policy_file": "namespace-selector-ingress-with-ports.yaml",
  "queries": [
    {
      "name": "allowed_namespace_ingress",
      "description": "Workloads in backend-ns may reach mongodb on TCP/27017",
      "query": {
        "source_namespace": "backend-ns",
        "dest_namespace": "database-ns",
        "source_workload": "order-service",
        "dest_workload": "mongodb",
        "port": 27017,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "denied_namespace_ingress",
      "description": "Workloads in frontend-ns may not reach mongodb on TCP/27017",
      "query": {
        "source_namespace": "frontend-ns",
        "dest_namespace": "database-ns",
        "source_workload": "store-front",
        "dest_workload": "mongodb",
        "port": 27017,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": false,
        "tier": "policy_deny"
      }
    }
  ]
}
