{
  "policy_file": "cilium-ingress-deny.yaml",
  "queries": [
    {
      "name": "allowed_before_deny",
      "description": "Cilium ingress allow rule permits order-service to reach mongodb on TCP/27017",
      "query": {
        "source_namespace": "backend-ns",
        "dest_namespace": "database-ns",
        "source_workload": "order-service",
        "dest_workload": "mongodb",
        "port": 27017,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "denied_by_ingress_deny",
      "description": "Cilium ingressDeny overrides allow and blocks makeline-service to mongodb on TCP/27017",
      "query": {
        "source_namespace": "backend-ns",
        "dest_namespace": "database-ns",
        "source_workload": "makeline-service",
        "dest_workload": "mongodb",
        "port": 27017,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": false,
        "tier": "cilium_deny"
      }
    }
  ]
}
