{
  "policy_file": "cilium-clusterwide-cross-namespace.yaml",
  "queries": [
    {
      "name": "allowed_clusterwide_ingress",
      "description": "Clusterwide Cilium policy allows makeline-service to reach mongodb on TCP/27017",
      "query": {
        "source_namespace": "backend-ns",
        "dest_namespace": "database-ns",
        "source_workload": "makeline-service",
        "dest_workload": "mongodb",
        "port": 27017,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "denied_clusterwide_ingress",
      "description": "Clusterwide policy denies frontend workloads reaching mongodb on TCP/27017",
      "query": {
        "source_namespace": "frontend-ns",
        "dest_namespace": "database-ns",
        "source_workload": "store-front",
        "dest_workload": "mongodb",
        "port": 27017,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": false,
        "tier": "policy_deny"
      }
    }
  ]
}
