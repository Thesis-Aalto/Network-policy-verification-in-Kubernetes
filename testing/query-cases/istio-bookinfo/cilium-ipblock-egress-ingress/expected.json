{
  "policy_file": "cilium-ipblock-egress-ingress.yaml",
  "queries": [
    {
      "name": "allowed_cilium_ingress_from_cidr",
      "description": "Cilium fromCIDR allows 172.17.5.1 to reach reviews-v1 on TCP/9080",
      "query": {
        "source_namespace": "bookinfo-services-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "172.17.5.1",
        "dest_workload": "reviews-v1",
        "port": 9080,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "allowed_cilium_egress_to_cidr",
      "description": "Cilium toCIDR allows reviews-v1 to reach 10.0.0.50 on TCP/443",
      "query": {
        "source_namespace": "bookinfo-services-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "reviews-v1",
        "dest_workload": "10.0.0.50",
        "port": 443,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "denied_cilium_egress_to_pod",
      "description": "Cilium toCIDR denies reviews-v1 to details-v1",
      "query": {
        "source_namespace": "bookinfo-services-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "reviews-v1",
        "dest_workload": "details-v1"
      },
      "expected": {
        "reachable": false,
        "tier": "policy_deny"
      }
    }
  ]
}
