{
  "policy_file": "namespace-selector-ingress-with-ports.yaml",
  "queries": [
    {
      "name": "allowed_namespace_ingress",
      "description": "Workloads in bookinfo-frontend-ns may reach services on TCP/9080",
      "query": {
        "source_namespace": "bookinfo-frontend-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "productpage-v1",
        "dest_workload": "details-v1",
        "port": 9080,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "denied_namespace_ingress",
      "description": "Workloads in bookinfo-data-ns may not reach services on TCP/9080",
      "query": {
        "source_namespace": "bookinfo-data-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "ratings-v1",
        "dest_workload": "details-v1",
        "port": 9080,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": false,
        "tier": "policy_deny"
      }
    }
  ]
}
