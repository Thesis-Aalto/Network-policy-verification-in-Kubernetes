{
  "policy_file": "namespace-selector-egress-with-ports.yaml",
  "queries": [
    {
      "name": "allowed_namespace_egress",
      "description": "bookinfo-services-ns workloads may egress to bookinfo-data-ns on TCP/9080",
      "query": {
        "source_namespace": "bookinfo-services-ns",
        "dest_namespace": "bookinfo-data-ns",
        "source_workload": "reviews-v1",
        "dest_workload": "ratings-v1",
        "port": 9080,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "denied_namespace_egress",
      "description": "bookinfo-services-ns workloads may not egress to ratings-v1 on TCP/27017",
      "query": {
        "source_namespace": "bookinfo-services-ns",
        "dest_namespace": "bookinfo-data-ns",
        "source_workload": "reviews-v1",
        "dest_workload": "ratings-v1",
        "port": 27017,
        "protocol": "TCP"
      },
      "expected": {
        "reachable": false,
        "tier": "policy_deny"
      }
    }
  ]
}
