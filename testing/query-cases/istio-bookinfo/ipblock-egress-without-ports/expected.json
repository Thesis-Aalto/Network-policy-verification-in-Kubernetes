{
  "policy_file": "ipblock-egress-without-ports.yaml",
  "queries": [
    {
      "name": "allowed_egress_cidr_without_port",
      "description": "reviews-v1 may egress to 10.0.0.0/24 without a port restriction",
      "query": {
        "source_namespace": "bookinfo-services-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "reviews-v1",
        "dest_workload": "10.0.0.0/24"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "denied_egress_pod",
      "description": "reviews-v1 may not egress to details-v1 when only the CIDR is allowed",
      "query": {
        "source_namespace": "bookinfo-services-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "reviews-v1",
        "dest_workload": "details-v1"
      },
      "expected": {
        "reachable": false,
        "tier": "policy_deny"
      }
    }
  ]
}
