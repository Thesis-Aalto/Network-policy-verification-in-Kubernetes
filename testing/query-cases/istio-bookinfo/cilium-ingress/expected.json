{
  "policy_file": "cilium-pod-selector-egress-ingress.yaml",
  "queries": [
    {
      "name": "allowed_cilium_ingress",
      "description": "Cilium ingress rule allows details-v1 to reach reviews-v1",
      "query": {
        "source_namespace": "bookinfo-services-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "details-v1",
        "dest_workload": "reviews-v1"
      },
      "expected": {
        "reachable": true,
        "tier": "policy_allow"
      }
    },
    {
      "name": "denied_cilium_ingress",
      "description": "Cilium ingress policy denies productpage-v1 to reviews-v1",
      "query": {
        "source_namespace": "bookinfo-frontend-ns",
        "dest_namespace": "bookinfo-services-ns",
        "source_workload": "productpage-v1",
        "dest_workload": "reviews-v1"
      },
      "expected": {
        "reachable": false,
        "tier": "policy_deny"
      }
    }
  ]
}
